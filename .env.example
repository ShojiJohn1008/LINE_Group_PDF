# LINE Messaging API (provider's single official account)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google OAuth app (provider-owned, shared by all tenants).
# Use a "Web application" OAuth client and register
#   <PUBLIC_BASE_URL>/oauth/callback
# as an authorized redirect URI. Users never touch Cloud Console.
GOOGLE_OAUTH_CLIENT_JSON=

# Public base URL the bot links to and Google redirects back to.
# For local pilots this is the ngrok URL, e.g. https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# Multi-tenant store (JSON file for the pilot) + at-rest encryption.
# Generate the key with: openssl rand -hex 32
TENANT_STORE_PATH=data/tenants.json
TENANT_ENCRYPTION_KEY=
# Optional: secret used to sign OAuth state tokens (defaults to LINE_CHANNEL_SECRET).
OAUTH_STATE_SECRET=

# Summary generation (provider-owned, metered cost)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Free tier: summaries/saves per tenant per calendar month (JST)
FREE_MONTHLY_LIMIT=50

# Server
PORT=3000
