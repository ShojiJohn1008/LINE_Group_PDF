# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Google Drive
# Recommended for personal Google Drive: OAuth.
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_TOKEN_JSON=secrets/google-oauth-token.json
# Alternative for Google Workspace shared drives.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# Optional. If empty, the app creates/fetches `references.md` inside GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_DRIVE_INDEX_FILE_ID=

# Summary generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server
PORT=3000
